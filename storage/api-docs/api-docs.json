            "get": {
                "tags": [
                    "Cheatsheets"
                ],
                "summary": "取得所有指令清單",
                "operationId": "6a32ad8ca1161f92fcb054a7be4a91af",
                "responses": {
                    "200": {
                        "description": "成功回傳清單"
                    }
                }
            }
        },
        "/api/cheatsheets/create": {
            "post": {
                "tags": [
                    "Cheatsheets"
                ],
                "summary": "新增一筆指令",
                "operationId": "8915f0e625aae82a9b23967d91402674",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "title": {
                                        "type": "string",
                                        "example": "學習 Laravel Swagger"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "建立成功"
                    },
                    "422": {
                        "description": "驗證錯誤"
                    }
                }
            }
        },
        "/cheatsheets/{cheatsheet}": {
            "get": {
                "tags": [
                    "Cheatsheets"
                ],
                "summary": "取得單一指令細節",
                "description": "$.ajax({\n        url: '/api/cheatsheets/' + id,\n        type: 'POST',\n        data: { _method: 'DELETE' },\n        headers: {\n            'X-Creater-Name': 'JohnDoe' // 在這裡手動加入 Header\n        },\n        success: function(res) {\n            console.log('刪除成功');\n        }\n    });",
                "operationId": "df696af2a507aad389ac79ab5ca0d120",
                "parameters": [
                    {
                        "name": "cheatsheet",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "成功"
                    },
                    "404": {
                        "description": "找不到項目"
                    }
                }
            },
            "put": {
                "tags": [
                    "Cheatsheets"
                ],
                "summary": "更新指令",
                "operationId": "76efdef1a2ff232ed467ad545e283a65",
                "parameters": [
                    {
                        "name": "cheatsheet",
                        "in": "path",
                        "description": "指令的 ID",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "狀態更新成功"
                    },
                    "404": {
                        "description": "找不到該項目"
                    }
                }
            }
        },
        "/api/cheatsheets/{id}/{creater}": {
            "delete": {
                "tags": [
                    "Cheatsheets"
                ],
                "summary": "刪除指定的指令",
                "operationId": "0bae56fce889dd872fbed5ecf95fdd07",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "指令的 ID",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "creater",
                        "in": "path",
                        "description": "建立者名稱",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "刪除成功"
                    },
                    "404": {
                        "description": "找不到該項目"
                    },
                    "403": {
                        "description": "權限不足"
                    }
                }
            }
        },
        "/api/cheatsheetsHeader/{id}": {
            "delete": {
                "tags": [
                    "Cheatsheets"
                ],
                "summary": "刪除指定的指令",
                "operationId": "3e07742650f48a03a9fe94fcb0d94e49",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "指令的 ID",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "X-Creater-Name",
                        "in": "header",
                        "description": "建立者名稱",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "刪除成功"
                    },
                    "400": {
                        "description": "缺少必要的 Header"
                    },
                    "404": {
                        "description": "找不到該項目"
                    }
                }
            }
        },
